# Cadena de conexión de Neon (Dashboard > Connect > pooled connection)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secreto para firmar sesiones. Generar con: openssl rand -base64 32
AUTH_SECRET=cambiar-por-un-valor-largo-y-aleatorio

# Zona horaria para "ruta de hoy"
TZ_APP=America/Argentina/Buenos_Aires

# Punto de salida de las rutas (depósito). Lo usa el optimizador y el mapa.
DEPOSITO_DIRECCION=Av. Corrientes 1234, Buenos Aires, Argentina
# true = la ruta vuelve al depósito; false = termina en la última parada
RUTA_VOLVER_AL_DEPOSITO=true

# Google Apps Script (optimizador de rutas). Dejar vacío para usar el orden manual.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# Token que usa el Apps Script para leer /api/sheets/export
SHEETS_TOKEN=cambiar-por-otro-valor-largo

# Opcional: link a tu Google Sheet para el botón "Abrir en Sheets"
NEXT_PUBLIC_SHEET_URL=
